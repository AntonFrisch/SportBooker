# Login-Zugangsdaten fuer den ueber "Passwort setzen" angelegten Account.
HSP_USERNAME=""
HSP_PASSWORD=""

# Kategorie-Seite (Schwimmen, Fitness, ...), die beobachtet werden soll.
# Beispiel: HSP_CATEGORY_URL="https://www.anmeldung.sport.uni-erlangen.de/hsp/angebote/aktueller_zeitraum_0/_Schwimmen___Swimming.html"
HSP_CATEGORY_URL=""

# Kursnummer = Spalte "Nr." in der Kurstabelle (mit 'python3 hsp_watcher.py --list' anzeigen lassen).
# Beispiel: HSP_KURSNR="2032"
HSP_KURSNR=""

# Zeitpunkt, ab dem die Buchung geoeffnet wird. Format: TT.MM.JJJJ HH:MM[:SS] (Zeitzone Europe/Berlin).
# Beispiel: HSP_OPENING_TIME="01.10.2026 08:00:00"
HSP_OPENING_TIME=""
